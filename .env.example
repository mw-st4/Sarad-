# .env.example

# TMDB API keys
TMDB_API_KEY=your_tmdb_api_key_here

# Stripe test keys
STRIPE_TEST_PUBLIC_KEY=your_stripe_test_public_key_here
STRIPE_TEST_SECRET_KEY=your_stripe_test_secret_key_here

# Database URL
DATABASE_URL=your_database_url_here

# JWT secret
JWT_SECRET=your_jwt_secret_here

# Feature flags
FEATURE_FLAG_X=true
FEATURE_FLAG_Y=false